# Server only. Local PostgreSQL or Supabase PostgreSQL / session pooler connection.
# Set a real password in your deployment secret store. Never expose DATABASE_URL.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/life_os

# Optional in local preview; REQUIRED for production Supabase Auth.
# These are the ONLY client-environment-variable names used by this application.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set false in production. If Supabase is configured, demo mode is always disabled.
ALLOW_DEMO=false
